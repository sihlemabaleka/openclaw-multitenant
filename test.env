# Test Environment Variables for Multi-Tenant Docker Testing
# Copy this to .env and fill in real values for testing

# Gateway authentication (required)
OPENCLAW_GATEWAY_TOKEN=test-gateway-token-12345

# OpenRouter API key (required for AI)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Telegram bot token (optional - only if testing Telegram)
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefYourTelegramBotTokenHere

# Cloudflare R2 for backups (optional)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=openclaw-backups

# User ID for this tenant
OPENCLAW_USER_ID=test-tenant-123
